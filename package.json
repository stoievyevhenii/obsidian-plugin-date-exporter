{
  "name": "daily-notes-txt-export",
  "version": "1.1.1",
  "private": true,
  "description": "Export daily Markdown lists to one dated TXT report on desktop and Android.",
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "author": "Yevhenii Stoiev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stoievyevhenii/obsidian-plugin-date-exporter.git"
  },
  "homepage": "https://github.com/stoievyevhenii/obsidian-plugin-date-exporter#readme",
  "bugs": {
    "url": "https://github.com/stoievyevhenii/obsidian-plugin-date-exporter/issues"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "engines": { "node": "^22.22.0 || >=24.0.0" },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "node scripts/test.mjs",
    "lint": "eslint src --max-warnings 0",
    "verify": "npm run lint && npm run test && npm run build && node scripts/check-bundle.mjs && node scripts/check-publication.mjs",
    "package": "npm run verify && node scripts/package.mjs"
  },
  "dependencies": {
    "entities": "6.0.1",
    "marked": "16.4.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "eslint": "10.13.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "jsdom": "26.1.0",
    "obsidian": "1.8.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
